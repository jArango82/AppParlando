      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Manrope:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .font-serif { font-family: 'Cormorant Garamond', serif; }\n  .font-body { font-family: 'Manrope', sans-serif; }\n  .hide-scroll::-webkit-scrollbar { display: none; }\n  .hide-scroll { -ms-overflow-style: none; scrollbar-width: none; }\n</style>\n\n<div class=\"font-body relative min-h-screen w-full overflow-x-hidden bg-[#013220] text-white\" data-kid=\"1\">\n\n  \n  <div class=\"fixed inset-0 z-0\" data-kid=\"2\">\n    <img src=\"https://images.unsplash.com/photo-1759968636716-347c338d4319?auto=format&w=750&q=80&fit=crop\" alt=\"Biblioteca clásica\" decoding=\"async\" loading=\"lazy\" class=\"h-full w-full object-cover\" data-kid=\"3\">\n    <div class=\"absolute inset-0 bg-gradient-to-b from-[#013220]/80 via-[#013220]/88 to-[#012117]/97\" data-kid=\"4\"></div>\n  </div>\n\n  \n  <div class=\"relative z-10 px-5 pb-12 pt-9\" data-kid=\"5\">\n\n    \n    <header class=\"flex flex-col items-center text-center\" data-kid=\"6\">\n      <div class=\"relative\" data-kid=\"7\">\n        <div class=\"absolute -inset-1.5 rounded-full bg-[#CBA135]/40 blur-md\" data-kid=\"8\"></div>\n        <img src=\"https://i.pravatar.cc/120?u=mateo\" alt=\"Mateo\" decoding=\"async\" loading=\"lazy\" class=\"relative h-16 w-16 rounded-full object-cover ring-1 ring-[#CBA135]/70 shadow-[0_0_24px_rgba(203,161,53,0.45)]\" data-kid=\"9\">\n      </div>\n      <p class=\"mt-4 text-[11px] font-semibold uppercase tracking-[0.32em] text-[#CBA135]\" data-kid=\"10\">Buenos días</p>\n      <h1 class=\"font-serif text-5xl font-semibold leading-none tracking-wide text-white\" data-kid=\"11\">Mateo</h1>\n    </header>\n\n    \n    <section class=\"mt-9\" data-kid=\"12\">\n      <p class=\"mb-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-white/55\" data-kid=\"13\">Continuar aprendiendo</p>\n      <div class=\"rounded-3xl border border-white/20 bg-white/10 p-5 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.7)] backdrop-blur-xl\" data-kid=\"14\">\n        <div class=\"flex items-start justify-between gap-4\" data-kid=\"15\">\n          <div class=\"min-w-0\" data-kid=\"16\">\n            <span class=\"inline-block rounded-full bg-[#CBA135] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[#013220]\" data-kid=\"17\">Nivel A2</span>\n            <h2 class=\"font-serif mt-3 text-[26px] font-semibold leading-[1.12] text-white\" data-kid=\"18\">Present Perfect: experiencias de vida</h2>\n          </div>\n\n          \n          <div class=\"relative shrink-0 pt-1\" style=\"width:96px;height:60px;\" data-kid=\"19\">\n            <svg viewBox=\"0 0 100 56\" class=\"w-24\" data-kid=\"20\">\n              <path d=\"M6 52 A44 44 0 0 1 94 52\" fill=\"none\" stroke=\"rgba(255,255,255,0.18)\" stroke-width=\"8\" stroke-linecap=\"round\" data-kid=\"21\"></path>\n              <path d=\"M6 52 A44 44 0 0 1 94 52\" fill=\"none\" stroke=\"#CBA135\" stroke-width=\"8\" stroke-linecap=\"round\" stroke-dasharray=\"138.2\" stroke-dashoffset=\"55.3\" data-kid=\"22\"></path>\n            </svg>\n            <div class=\"absolute inset-x-0 bottom-0 text-center\" data-kid=\"23\">\n              <span class=\"font-serif text-2xl font-bold text-white\" data-kid=\"24\">60</span><span class=\"text-xs font-bold text-[#CBA135]\" data-kid=\"25\">%</span>\n            </div>\n          </div>\n        </div>\n\n        <button id=\"resume-btn\" class=\"mt-5 flex w-full items-center justify-center gap-2 rounded-2xl border border-[#CBA135]/60 bg-white/5 py-3.5 text-sm font-bold uppercase tracking-[0.16em] text-[#CBA135]\" data-kid=\"26\">\n          <span data-kid=\"27\">Reanudar</span>\n          <i class=\"ti ti-arrow-right text-base\" data-kid=\"28\"></i>\n        </button>\n      </div>\n    </section>\n\n    \n    <section class=\"mt-11\" data-kid=\"29\">\n      <div class=\"relative mx-1 -rotate-1 rounded-xl bg-[#FBF8F1] p-6 pt-7 text-[#1c2b22] shadow-[0_18px_40px_-12px_rgba(0,0,0,0.6)]\" data-kid=\"30\">\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/bookmark.svg\" alt decoding=\"async\" loading=\"lazy\" class=\"absolute -top-3 left-7 h-9 w-9 rotate-1 drop-shadow-md\" style=\"filter: invert(63%) sepia(48%) saturate(640%) hue-rotate(2deg) brightness(92%) contrast(88%);\" data-kid=\"31\">\n        <p class=\"text-[10px] font-bold uppercase tracking-[0.3em] text-[#CBA135]\" data-kid=\"32\">Consejo del día</p>\n        <p class=\"mt-2 text-[15px] leading-relaxed\" data-kid=\"33\">\n          <span class=\"font-serif float-left mr-2 mt-1 text-6xl font-bold leading-[0.7] text-[#013220]\" data-kid=\"34\">E</span>\n          scucha podcasts en inglés 10 minutos al día y mejora tu comprensión rápidamente.\n        </p>\n      </div>\n    </section>\n\n    \n    <section class=\"mt-11\" data-kid=\"35\">\n      <h3 class=\"font-serif mb-4 px-1 text-3xl font-semibold text-white\" data-kid=\"36\">Qué aprenderás</h3>\n    </section>\n    <div class=\"hide-scroll flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2\" style=\"margin-left:-20px;margin-right:-20px;\" data-kid=\"37\">\n      \n      <article class=\"relative flex min-w-[70%] snap-center flex-col justify-end overflow-hidden rounded-3xl border border-white/20 bg-white/10 p-5 backdrop-blur-xl\" style=\"height:200px;\" data-kid=\"38\">\n        <i class=\"ti ti-book-2 pointer-events-none absolute -right-3 -top-3 text-white/10\" style=\"font-size:120px;\" data-kid=\"39\"></i>\n        <p class=\"text-[10px] font-bold uppercase tracking-[0.22em] text-[#CBA135]\" data-kid=\"40\">01</p>\n        <h4 class=\"font-serif mt-1 text-3xl font-semibold text-white\" data-kid=\"41\">Gramática</h4>\n        <p class=\"mt-1 text-xs font-medium text-white/65\" data-kid=\"42\">Reglas y tiempos</p>\n      </article>\n      <article class=\"relative flex min-w-[70%] snap-center flex-col justify-end overflow-hidden rounded-3xl border border-white/20 bg-white/10 p-5 backdrop-blur-xl\" style=\"height:200px;\" data-kid=\"43\">\n        <i class=\"ti ti-volume-2 pointer-events-none absolute -right-3 -top-3 text-white/10\" style=\"font-size:120px;\" data-kid=\"44\"></i>\n        <p class=\"text-[10px] font-bold uppercase tracking-[0.22em] text-[#CBA135]\" data-kid=\"45\">02</p>\n        <h4 class=\"font-serif mt-1 text-3xl font-semibold text-white\" data-kid=\"46\">Escucha</h4>\n        <p class=\"mt-1 text-xs font-medium text-white/65\" data-kid=\"47\">Ejercicios de audio</p>\n      </article>\n      <article class=\"relative flex min-w-[70%] snap-center flex-col justify-end overflow-hidden rounded-3xl border border-white/20 bg-white/10 p-5 backdrop-blur-xl\" style=\"height:200px;\" data-kid=\"48\">\n        <i class=\"ti ti-feather pointer-events-none absolute -right-3 -top-3 text-white/10\" style=\"font-size:120px;\" data-kid=\"49\"></i>\n        <p class=\"text-[10px] font-bold uppercase tracking-[0.22em] text-[#CBA135]\" data-kid=\"50\">03</p>\n        <h4 class=\"font-serif mt-1 text-3xl font-semibold text-white\" data-kid=\"51\">Escritura</h4>\n        <p class=\"mt-1 text-xs font-medium text-white/65\" data-kid=\"52\">Práctica escrita</p>\n      </article>\n      <article class=\"relative flex min-w-[70%] snap-center flex-col justify-end overflow-hidden rounded-3xl border border-white/20 bg-white/10 p-5 backdrop-blur-xl\" style=\"height:200px;margin-right:20px;\" data-kid=\"53\">\n        <i class=\"ti ti-typography pointer-events-none absolute -right-3 -top-3 text-white/10\" style=\"font-size:120px;\" data-kid=\"54\"></i>\n        <p class=\"text-[10px] font-bold uppercase tracking-[0.22em] text-[#CBA135]\" data-kid=\"55\">04</p>\n        <h4 class=\"font-serif mt-1 text-3xl font-semibold text-white\" data-kid=\"56\">Vocabulario</h4>\n        <p class=\"mt-1 text-xs font-medium text-white/65\" data-kid=\"57\">Aprende palabras</p>\n      </article>\n    </div>\n\n    \n    <section class=\"relative mt-12 px-1\" data-kid=\"58\">\n      <span class=\"font-serif pointer-events-none absolute -top-16 left-0 select-none leading-none text-[#CBA135]/[0.08]\" style=\"font-size:200px;\" data-kid=\"59\">“</span>\n      <div class=\"relative pl-8 text-right\" data-kid=\"60\">\n        <p class=\"font-serif text-2xl font-medium italic leading-snug text-white/90\" data-kid=\"61\">“Todo experto fue alguna vez un principiante.”</p>\n        <p class=\"mt-3 text-[11px] font-semibold uppercase tracking-[0.26em] text-[#CBA135]\" data-kid=\"62\">— Motivación del día</p>\n      </div>\n    </section>\n\n  </div>\n</div>\n\n<script type=\"module\" data-kid=\"63\">\n  import { hover, animate } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\";\n  const btn = document.getElementById(\"resume-btn\");\n  if (btn) {\n    hover(btn, (el) => {\n      animate(el, { backgroundColor: \"#CBA135\", color: \"#013220\", borderColor: \"#CBA135\" }, { duration: 0.3, ease: \"easeOut\" });\n      return () => animate(el, { backgroundColor: \"rgba(255,255,255,0.05)\", color: \"#CBA135\", borderColor: \"rgba(203,161,53,0.6)\" }, { duration: 0.3 });\n    });\n  }\n</script>",
