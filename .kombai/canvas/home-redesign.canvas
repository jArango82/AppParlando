      "html": "<div class=\"min-h-screen w-full bg-[#111111] text-[#F5F5DC] font-mono pb-0\" style=\"font-family: 'IBM Plex Mono', monospace;\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n    .font-grotesk { font-family: 'Space Grotesk', sans-serif; }\n    @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }\n    .term-cursor { animation: blink 1s step-end infinite; }\n    @keyframes marquee-x { from { transform: translateX(0); } to { transform: translateX(-50%); } }\n    .marquee-track { animation: marquee-x 18s linear infinite; }\n    .hex-mask { clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%); }\n  </style>\n\n  \n  <header class=\"sticky top-0 z-30 bg-[#111111] border-b border-[#F5F5DC]/30 px-5 py-4 flex items-center justify-between\" data-kid=\"2\">\n    <div class=\"flex flex-col gap-1\" data-kid=\"3\">\n      <span class=\"text-[10px] tracking-[0.2em] text-[#F5F5DC]/60\" data-kid=\"4\">[ 08:42 AM ]</span>\n      <span class=\"text-[13px] font-medium tracking-[0.15em] text-[#F5F5DC]\" data-kid=\"5\">HOLA, MATEO</span>\n    </div>\n    <div class=\"relative\" data-kid=\"6\">\n      <img src=\"https://i.pravatar.cc/120?u=mateo\" alt=\"Avatar de Mateo\" decoding=\"async\" loading=\"lazy\" class=\"w-11 h-11 object-cover hex-mask grayscale\" data-kid=\"7\">\n      <span class=\"absolute bottom-0 right-0 w-2.5 h-2.5 bg-[#39FF14] rounded-full border-2 border-[#111111]\" data-kid=\"8\"></span>\n    </div>\n  </header>\n\n  <main class=\"px-5 pt-6 flex flex-col gap-9\" data-kid=\"9\">\n\n    \n    <section data-kid=\"10\">\n      <div class=\"flex items-center justify-between mb-3\" data-kid=\"11\">\n        <span class=\"text-[10px] tracking-[0.25em] text-[#F5F5DC]/50\" data-kid=\"12\">// CONTINUAR_APRENDIENDO</span>\n      </div>\n      <div class=\"relative overflow-hidden border border-[#F5F5DC] bg-[#161616] p-5\" data-kid=\"13\">\n        \n        <i class=\"ti ti-terminal absolute -right-3 -top-4 text-[120px] leading-none text-[#F5F5DC]/[0.04]\" data-kid=\"14\"></i>\n        <div class=\"relative\" data-kid=\"15\">\n          <div class=\"flex items-center gap-3\" data-kid=\"16\">\n            <span class=\"bg-[#39FF14] text-[#111111] text-[12px] font-bold px-2.5 py-1 leading-none\" data-kid=\"17\">A2</span>\n            <span class=\"text-[10px] tracking-[0.2em] text-[#F5F5DC]/55\" data-kid=\"18\">MODULO_ACTUAL</span>\n          </div>\n          <h2 class=\"font-grotesk text-[#F5F5DC] text-[22px] leading-[1.15] font-bold mt-4\" data-kid=\"19\">\n            Present Perfect: experiencias de vida\n          </h2>\n          <p class=\"text-[11px] tracking-wide text-[#F5F5DC]/80 mt-5\" data-kid=\"20\">\n            PROGRESO: <span class=\"text-[#39FF14]\" data-kid=\"21\">[||||||</span><span class=\"text-[#F5F5DC]/30\" data-kid=\"22\">....]</span> 60%\n          </p>\n          <div class=\"mt-5 pt-4 border-t border-[#F5F5DC]/15 flex items-center\" data-kid=\"23\">\n            <span class=\"text-[13px] font-medium tracking-[0.12em] text-[#39FF14]\" data-kid=\"24\">&gt; EMPEZAR_LECCION</span>\n            <span class=\"term-cursor inline-block w-2.5 h-4 bg-[#39FF14] ml-2\" data-kid=\"25\"></span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section data-kid=\"26\">\n      <div class=\"flex items-stretch border border-[#F5F5DC]/40\" data-kid=\"27\">\n        <div class=\"bg-[#F5F5DC] flex items-center justify-center w-12 shrink-0\" data-kid=\"28\">\n          <span class=\"text-[#111111] font-bold text-[12px] tracking-[0.25em]\" style=\"writing-mode: vertical-rl; transform: rotate(180deg);\" data-kid=\"29\">TIP_042</span>\n        </div>\n        <div class=\"border-l-2 border-[#39FF14] px-4 py-5 flex flex-col gap-2\" data-kid=\"30\">\n          <span class=\"text-[9px] tracking-[0.3em] text-[#F5F5DC]/45\" data-kid=\"31\">DAILY_INSIGHT</span>\n          <p class=\"text-[12.5px] leading-[1.7] text-[#F5F5DC]\" data-kid=\"32\">\n            Escucha podcasts en inglés 10 minutos al día — mejora tu comprensión rápidamente.\n          </p>\n        </div>\n      </div>\n    </section>\n\n    \n    <section data-kid=\"33\">\n      <div class=\"flex items-center justify-between mb-5\" data-kid=\"34\">\n        <h3 class=\"font-grotesk text-[15px] font-bold tracking-[0.15em] text-[#F5F5DC]\" data-kid=\"35\">QUÉ APRENDERÁS</h3>\n        <span class=\"text-[10px] tracking-[0.2em] text-[#F5F5DC]/45\" data-kid=\"36\">RUTA_CURRICULO</span>\n      </div>\n      <div class=\"relative pl-6\" data-kid=\"37\">\n        \n        <div class=\"absolute left-[5px] top-1 bottom-1 w-px bg-[#F5F5DC]/40\" data-kid=\"38\"></div>\n        <div id=\"timeline\" class=\"flex flex-col gap-7\" data-kid=\"39\">\n          <div class=\"card relative\" data-kid=\"40\">\n            <span class=\"absolute -left-[23px] top-1 w-2.5 h-2.5 bg-[#39FF14]\" data-kid=\"41\"></span>\n            <h4 class=\"font-grotesk text-[16px] font-bold tracking-[0.1em] text-[#F5F5DC]\" data-kid=\"42\">GRAMÁTICA</h4>\n            <span class=\"text-[10px] tracking-[0.18em] text-[#F5F5DC]/55\" data-kid=\"43\">REGLAS_ESTRUCTURALES</span>\n          </div>\n          <div class=\"card relative\" data-kid=\"44\">\n            <span class=\"absolute -left-[23px] top-1 w-2.5 h-2.5 bg-[#39FF14]\" data-kid=\"45\"></span>\n            <h4 class=\"font-grotesk text-[16px] font-bold tracking-[0.1em] text-[#F5F5DC]\" data-kid=\"46\">ESCUCHA</h4>\n            <span class=\"text-[10px] tracking-[0.18em] text-[#F5F5DC]/55\" data-kid=\"47\">COMPRENSION_AUDITIVA</span>\n          </div>\n          <div class=\"card relative\" data-kid=\"48\">\n            <span class=\"absolute -left-[23px] top-1 w-2.5 h-2.5 bg-[#39FF14]\" data-kid=\"49\"></span>\n            <h4 class=\"font-grotesk text-[16px] font-bold tracking-[0.1em] text-[#F5F5DC]\" data-kid=\"50\">ESCRITURA</h4>\n            <span class=\"text-[10px] tracking-[0.18em] text-[#F5F5DC]/55\" data-kid=\"51\">PRODUCCION_ESCRITA</span>\n          </div>\n          <div class=\"card relative\" data-kid=\"52\">\n            <span class=\"absolute -left-[23px] top-1 w-2.5 h-2.5 bg-[#39FF14]\" data-kid=\"53\"></span>\n            <h4 class=\"font-grotesk text-[16px] font-bold tracking-[0.1em] text-[#F5F5DC]\" data-kid=\"54\">VOCABULARIO</h4>\n            <span class=\"text-[10px] tracking-[0.18em] text-[#F5F5DC]/55\" data-kid=\"55\">LEXICO</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"-mx-5 mt-2\" data-kid=\"56\">\n      <div class=\"bg-[#F5F5DC] overflow-hidden py-2.5 border-y border-[#F5F5DC]\" data-kid=\"57\">\n        <div class=\"marquee-track flex w-max whitespace-nowrap\" data-kid=\"58\">\n          <span class=\"text-[#111111] font-bold text-[12px] tracking-[0.2em] pr-0\" data-kid=\"59\">TODO EXPERTO FUE ALGUNA VEZ UN PRINCIPIANTE&nbsp;&nbsp;&nbsp;•&nbsp;&nbsp;&nbsp;TODO EXPERTO FUE ALGUNA VEZ UN PRINCIPIANTE&nbsp;&nbsp;&nbsp;•&nbsp;&nbsp;&nbsp;</span>\n          <span class=\"text-[#111111] font-bold text-[12px] tracking-[0.2em]\" aria-hidden=\"true\" data-kid=\"60\">TODO EXPERTO FUE ALGUNA VEZ UN PRINCIPIANTE&nbsp;&nbsp;&nbsp;•&nbsp;&nbsp;&nbsp;TODO EXPERTO FUE ALGUNA VEZ UN PRINCIPIANTE&nbsp;&nbsp;&nbsp;•&nbsp;&nbsp;&nbsp;</span>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"61\">\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"62\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"63\"></script>\n  <script data-kid=\"64\">\n    gsap.registerPlugin(ScrollTrigger);\n    gsap.set(\".card\", { x: -24, autoAlpha: 0 });\n    ScrollTrigger.batch(\".card\", {\n      start: \"top 90%\",\n      onEnter: (els) => gsap.to(els, { x: 0, autoAlpha: 1, duration: 0.5, stagger: 0.12, overwrite: true })\n    });\n  </script>\n</div>",
