      "html": "<div id=\"app\" class=\"min-h-screen w-full bg-[#F4F0EC] text-[#003262] antialiased selection:bg-[#EEDC82]/60\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&family=Inter:wght@400;500;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n    .font-serif { font-family: 'Playfair Display', Georgia, serif; }\n    .font-sans { font-family: 'Inter', system-ui, sans-serif; }\n    .label-eyebrow { font-family:'Inter',sans-serif; text-transform:uppercase; letter-spacing:0.22em; }\n  </style>\n\n  <div class=\"font-sans px-5 pt-8 pb-12 max-w-[375px] mx-auto\" data-kid=\"2\">\n\n    \n    <header class=\"reveal flex items-center justify-between mb-8\" data-kid=\"3\">\n      <div class=\"flex flex-col\" data-kid=\"4\">\n        <span class=\"label-eyebrow text-[10px] font-semibold text-[#003262]/55\" data-kid=\"5\">Buenos días</span>\n        <h1 class=\"font-serif italic font-700 text-[34px] leading-none text-[#003262] mt-1\" data-kid=\"6\">Mateo</h1>\n      </div>\n      <div class=\"relative\" data-kid=\"7\">\n        <img src=\"https://i.pravatar.cc/120?u=mateo\" alt=\"Avatar de Mateo\" decoding=\"async\" loading=\"lazy\" class=\"w-14 h-14 object-cover rounded-sm grayscale-[15%] ring-1 ring-[#003262]/15\" data-kid=\"8\">\n        <span class=\"absolute -bottom-1 -right-1 w-3 h-3 bg-[#B31B1B] rounded-sm border-2 border-[#F4F0EC]\" data-kid=\"9\"></span>\n      </div>\n    </header>\n\n    \n    <section class=\"reveal -mx-5 mb-10\" data-kid=\"10\">\n      <div class=\"relative overflow-hidden bg-[#003262] text-white px-6 py-7 rounded-none\" data-kid=\"11\">\n        \n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/open-book.svg\" alt aria-hidden=\"true\" decoding=\"async\" loading=\"lazy\" style=\"color:#ffffff;\" class=\"pointer-events-none absolute -right-6 -bottom-8 w-44 h-44 opacity-[0.06]\" data-kid=\"12\">\n\n        <div class=\"relative\" data-kid=\"13\">\n          \n          <div class=\"flex items-center justify-between mb-6\" data-kid=\"14\">\n            <span class=\"label-eyebrow text-[10px] font-semibold text-white/55\" data-kid=\"15\">Módulo actual</span>\n            <span class=\"label-eyebrow text-[10px] font-bold text-[#003262] bg-[#EEDC82] px-2.5 py-1 rounded-sm\" data-kid=\"16\">Nivel A2</span>\n          </div>\n\n          \n          <h2 class=\"font-serif text-[26px] leading-[1.15] font-600 pr-4\" data-kid=\"17\">Present Perfect: experiencias de vida</h2>\n\n          \n          <div class=\"h-px w-full bg-white/20 my-6\" data-kid=\"18\"></div>\n\n          \n          <div class=\"flex items-center gap-1.5 mb-3\" data-kid=\"19\">\n            <span class=\"h-1.5 flex-1 rounded-sm bg-[#EEDC82]\" data-kid=\"20\"></span>\n            <span class=\"h-1.5 flex-1 rounded-sm bg-[#EEDC82]\" data-kid=\"21\"></span>\n            <span class=\"h-1.5 flex-1 rounded-sm bg-[#EEDC82]\" data-kid=\"22\"></span>\n            <span class=\"h-1.5 flex-1 rounded-sm bg-white/15\" data-kid=\"23\"></span>\n            <span class=\"h-1.5 flex-1 rounded-sm bg-white/15\" data-kid=\"24\"></span>\n          </div>\n\n          <div class=\"flex items-center justify-between\" data-kid=\"25\">\n            <span class=\"label-eyebrow text-[10px] font-medium text-white/55\" data-kid=\"26\">60% completado</span>\n            <a href=\"#\" class=\"group inline-flex items-center gap-2 text-[13px] font-semibold tracking-wide text-[#EEDC82]\" data-kid=\"27\">\n              Reanudar\n              <span class=\"inline-block text-base leading-none\" data-kid=\"28\">&#8594;</span>\n            </a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"reveal mb-12 relative pl-9\" data-kid=\"29\">\n      <span class=\"font-serif text-[#003262] text-[68px] leading-[0.7] absolute left-0 top-0 select-none\" data-kid=\"30\">&#8220;</span>\n      <p class=\"font-serif italic font-500 text-[19px] leading-[1.45] text-[#003262] pt-3\" data-kid=\"31\">\n        Escucha podcasts en inglés 10 minutos al día — mejora tu comprensión rápidamente.\n      </p>\n      <span class=\"label-eyebrow text-[10px] font-semibold text-[#B31B1B] block mt-4\" data-kid=\"32\">Consejo diario</span>\n    </section>\n\n    \n    <section class=\"reveal mb-12\" data-kid=\"33\">\n      <div class=\"flex items-baseline justify-between mb-4\" data-kid=\"34\">\n        <h3 class=\"font-serif font-600 text-[22px] text-[#003262]\" data-kid=\"35\">Qué aprenderás</h3>\n        <span class=\"label-eyebrow text-[9px] text-[#003262]/45 font-semibold\" data-kid=\"36\">04 áreas</span>\n      </div>\n\n      <div class=\"grid grid-cols-2 grid-rows-2 gap-0 border border-[#003262]/25\" data-kid=\"37\">\n        \n        <div class=\"row-span-2 relative border-r border-[#003262]/25 p-5 flex flex-col justify-between min-h-[224px]\" style=\"background-image:linear-gradient(135deg, rgba(238,220,130,0.10), rgba(0,50,98,0.03));\" data-kid=\"38\">\n          <i class=\"ti ti-book-2 text-[20px] text-[#003262]/70 absolute top-4 right-4\" data-kid=\"39\"></i>\n          <div class=\"mt-auto\" data-kid=\"40\">\n            <h4 class=\"font-serif font-600 text-[20px] text-[#003262] leading-tight\" data-kid=\"41\">Gramática</h4>\n            <p class=\"text-[11px] text-[#003262]/55 mt-1 font-medium\" data-kid=\"42\">Reglas y tiempos</p>\n          </div>\n        </div>\n\n        \n        <div class=\"relative border-b border-[#003262]/25 p-4 flex flex-col justify-between min-h-[112px]\" data-kid=\"43\">\n          <i class=\"ti ti-headphones text-[18px] text-[#003262]/70 absolute top-3 right-3\" data-kid=\"44\"></i>\n          <div class=\"mt-auto\" data-kid=\"45\">\n            <h4 class=\"font-serif font-600 text-[16px] text-[#003262] leading-tight\" data-kid=\"46\">Escucha</h4>\n            <p class=\"text-[10px] text-[#003262]/55 mt-0.5 font-medium\" data-kid=\"47\">Ejercicios de audio</p>\n          </div>\n        </div>\n\n        \n        <div class=\"relative p-4 flex flex-col justify-between min-h-[112px]\" data-kid=\"48\">\n          <i class=\"ti ti-pencil text-[18px] text-[#003262]/70 absolute top-3 right-3\" data-kid=\"49\"></i>\n          <div class=\"mt-auto\" data-kid=\"50\">\n            <h4 class=\"font-serif font-600 text-[16px] text-[#003262] leading-tight\" data-kid=\"51\">Escritura</h4>\n            <p class=\"text-[10px] text-[#003262]/55 mt-0.5 font-medium\" data-kid=\"52\">Práctica escrita</p>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"border border-t-0 border-[#003262]/25 relative p-4 flex items-center justify-between\" data-kid=\"53\">\n        <div data-kid=\"54\">\n          <h4 class=\"font-serif font-600 text-[16px] text-[#003262] leading-tight\" data-kid=\"55\">Vocabulario</h4>\n          <p class=\"text-[10px] text-[#003262]/55 mt-0.5 font-medium\" data-kid=\"56\">Aprende palabras</p>\n        </div>\n        <i class=\"ti ti-typography text-[18px] text-[#003262]/70\" data-kid=\"57\"></i>\n      </div>\n    </section>\n\n    \n    <section class=\"reveal border-t border-b border-[#003262]/30 py-6\" data-kid=\"58\">\n      <p class=\"font-serif text-[17px] leading-[1.5] text-[#003262] italic\" data-kid=\"59\">\n        &#8220;Todo experto fue alguna vez un principiante.&#8221;\n      </p>\n      <p class=\"label-eyebrow text-[9px] font-semibold text-[#003262]/55 text-right mt-3\" data-kid=\"60\">— Motivación del día</p>\n    </section>\n\n  </div>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"61\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"62\"></script>\n  <script data-kid=\"63\">\n    gsap.registerPlugin(ScrollTrigger);\n    gsap.set('.reveal', { autoAlpha: 0, y: 26 });\n    ScrollTrigger.batch('.reveal', {\n      start: 'top 92%',\n      onEnter: (els) => gsap.to(els, { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power2.out', stagger: 0.1, overwrite: true })\n    });\n  </script>\n</div>",
